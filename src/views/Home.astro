---
import Base from '../layouts/Base.astro';
import { links, routes, sunday, playlists, playlistEmbed, type Lang } from '../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const es = lang === 'es';

const copy = {
  es: {
    title: 'Iglesia de la Ciudad | Una iglesia de iglesias en casa en Doral',
    description: 'Iglesia cristiana en español en Doral, Miami. Nos reunimos los domingos a las 10 AM en John I. Smith K-8 y en iglesias en casa durante la semana. Ven tal como estás.',
    kicker: `Domingos ${sunday.time} · Doral, Miami`,
    h1: 'Una iglesia de iglesias en casa.',
    lead: 'Una familia de discípulos de Jesús que se reúne en hogares por toda la ciudad, y los domingos como una sola iglesia.',
    plan: 'Planea tu visita',
    houses: 'Iglesias en casa',
    heroAlt: 'Una mujer sonríe al salir del agua en su bautismo, junto a dos pastores',
    faithTitle: '¿Explorando la fe?',
    faithText: 'No una religión. Una persona. Conoce a Jesús tal como aparece en los evangelios.',
    faithBtn: 'Conoce a Jesús',
    bibleAlt: 'Una mano sobre una Biblia abierta',
    visitTitle: 'Visítanos un domingo.',
    visitAlt: 'La iglesia adorando un domingo',
    time: 'Hora', place: 'Lugar',
    visitSoft: 'Llega unos minutos antes. Hay café, y CityChurch Kids tiene un espacio para los niños.',
    visitBtn: 'Qué esperar',
    giant: ['De casa', 'en casa.'],
    mission: 'Somos una iglesia de iglesias en casa en Miami, con el anhelo de ver a Dios obrar de manera sobrenatural en cada ciudad, por medio de una comunidad de discípulos que viven el evangelio como una familia en misión.',
    about: 'Quiénes somos',
    newTitle: '¿Nuevo en Iglesia de la Ciudad?',
    newText: 'Ven tal como estás. Te esperamos en la puerta y te presentamos a alguien.',
    newBtn: 'Avísanos que vienes',
    newAlt: 'Una madre abraza a su hijo durante la adoración',
    sermonKicker: 'Último mensaje',
    sermonTitle: 'La Biblia, de manera simple y clara.',
    series: `Serie actual: ${playlists.current.name}.`,
    sermons: 'Todos los mensajes',
    bapGiant: 'Bautismo',
    bapTitle: '¿Listo para dar el paso?',
    bapText: 'Una clase, una conversación con un pastor y un domingo para celebrar con tu familia de la iglesia.',
    bapBtn: 'Sobre el bautismo',
    bapAlt: 'Un niño sale del agua en su bautismo, celebrado por su mamá y un pastor',
    houseTitle: 'La iglesia más cercana a ti es la tuya.',
    houseText: 'Durante la semana nos reunimos en hogares para comer juntos, orar y abrir la Biblia.',
    houseBtn: 'Únete a una iglesia en casa',
    houseAlt: 'La Biblia abierta durante una iglesia en casa',
    ctaTitle: 'Mantente conectado.',
    ctaText: 'Déjanos tus datos y te escribimos personalmente para ayudarte a dar el siguiente paso.',
    ctaBtn: 'Mantente conectado',
  },
  en: {
    title: 'CityChurch Miami | A church of house churches in Doral',
    description: 'A Christian church in Doral, Miami. We gather Sundays at 10 AM at John I. Smith K-8 (in Spanish) and in house churches across the city during the week. Come as you are.',
    kicker: `Sundays ${sunday.time} · Doral, Miami`,
    h1: 'A church of house churches.',
    lead: 'A family of disciples of Jesus who meet in homes across the city, and on Sundays as one church.',
    plan: 'Plan your visit',
    houses: 'House churches',
    heroAlt: 'A woman smiles as she comes up from the water at her baptism, with two pastors',
    faithTitle: 'Exploring faith?',
    faithText: 'Not a religion. A person. Meet Jesus as He appears in the Gospels.',
    faithBtn: 'Meet Jesus',
    bibleAlt: 'A hand resting on an open Bible',
    visitTitle: 'Visit on a Sunday.',
    visitAlt: 'The church worshiping on a Sunday',
    time: 'Time', place: 'Place',
    visitSoft: 'Arrive a few minutes early for coffee. CityChurch Kids has a space for children. The service is in Spanish.',
    visitBtn: 'What to expect',
    giant: ['House to', 'house.'],
    mission: 'We are a church of house churches in Miami, longing to see God work supernaturally in every city through a community of disciples who live out the gospel as a family on mission.',
    about: 'Who we are',
    newTitle: 'New to CityChurch?',
    newText: 'Come as you are. We will meet you at the door and introduce you to someone.',
    newBtn: 'Let us know you’re coming',
    newAlt: 'A mother hugs her son during worship',
    sermonKicker: 'Latest message',
    sermonTitle: 'The Bible, simple and clear.',
    series: `Current series: ${playlists.current.name} (in Spanish).`,
    sermons: 'All messages',
    bapGiant: 'Baptism',
    bapTitle: 'Ready to take the step?',
    bapText: 'One class, a conversation with a pastor, and a Sunday to celebrate with your church family.',
    bapBtn: 'About baptism',
    bapAlt: 'A boy comes up from the water at his baptism, celebrated by his mom and a pastor',
    houseTitle: 'The church closest to you is yours.',
    houseText: 'During the week we meet in homes to share a meal, pray, and open the Bible together.',
    houseBtn: 'Join a house church',
    houseAlt: 'An open Bible during a house church',
    ctaTitle: 'Stay connected.',
    ctaText: 'Leave us your info and we will reach out personally to help you take your next step.',
    ctaBtn: 'Stay connected',
  },
}[lang];
---
<Base lang={lang} page="home" title={copy.title} description={copy.description} image="/img/bautismo-alegria.webp">
  <section class="hero-full home-hero">
    <img src="/img/bautismo-alegria.webp" srcset="/img/bautismo-alegria-sm.webp 900w, /img/bautismo-alegria.webp 2200w" sizes="100vw" alt={copy.heroAlt} fetchpriority="high" />
    <div class="shade"></div>
    <div class="wrap">
      <span class="kicker">{copy.kicker}</span>
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="btn-row">
        <a class="btn btn--orange" href={routes.first[lang]}>{copy.plan}</a>
        <a class="btn btn--ghost" href={routes.houses[lang]}>{copy.houses}</a>
      </div>
    </div>
  </section>

  <section class="sunday-band">
    <div class="wrap sb">
      <div class="sb-time">
        <span class="sb-day">{es ? 'Domingos' : 'Sundays'}</span>
        <span class="sb-hour">{sunday.time.replace(':00', '')}</span>
      </div>
      <div class="sb-place">
        <strong>{sunday.place}</strong>
        <span>{sunday.address}</span>
        {!es && <em>Service in Spanish</em>}
      </div>
      <div class="sb-btns">
        <a class="btn btn--orange" href={routes.first[lang]}>{copy.plan}</a>
        <a class="btn btn--light-ghost" href={links.maps}>{es ? 'Cómo llegar' : 'Directions'}</a>
      </div>
    </div>
  </section>

  <section class="panels">
    <div class="panel panel--cream">
      <h2>{copy.faithTitle}</h2>
      <div class="panel-photo bw">
        <img src="/img/biblia-mano-sm.webp" alt={copy.bibleAlt} loading="lazy" width="900" height="600" />
        <span class="block" aria-hidden="true"></span>
      </div>
      <p>{copy.faithText}</p>
      <a class="btn btn--ghost" href={routes.jesus[lang]}>{copy.faithBtn}</a>
    </div>
    <div class="panel panel--dark">
      <h2>{copy.visitTitle}</h2>
      <div class="panel-photo">
        <img src="/img/domingo-adoracion-sm.webp" alt={copy.visitAlt} loading="lazy" width="900" height="676" />
      </div>
      <dl class="facts">
        <div><dt>{copy.time}</dt><dd>{es ? 'Domingos' : 'Sundays'}, {sunday.time}</dd></div>
        <div><dt>{copy.place}</dt><dd>{sunday.place}<br />{sunday.address}</dd></div>
      </dl>
      <p class="soft stone">{copy.visitSoft}</p>
      <a class="btn btn--ghost" href={routes.first[lang]}>{copy.visitBtn}</a>
    </div>
  </section>

  <section class="section poster">
    <div class="wrap">
      <p class="giant" aria-hidden="true">{copy.giant[0]}<br />{copy.giant[1]}</p>
      <blockquote class="mission-quote">{copy.mission}</blockquote>
      <a class="btn btn--ghost" href={routes.about[lang]}>{copy.about}</a>
    </div>
  </section>

  <section class="photo-band">
    <img src="/img/abrazo-adoracion.webp" alt={copy.newAlt} loading="lazy" style="object-position: 50% 35%" />
    <div class="shade"></div>
    <div class="wrap">
      <h2>{copy.newTitle}</h2>
      <p>{copy.newText}</p>
      <div class="btn-row"><a class="btn btn--light" href={links.stayConnected}>{copy.newBtn}</a></div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap split split--wide-left">
      <div class="video">
        <iframe src={playlistEmbed(playlists.latest)} title={copy.sermonKicker} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
      <div>
        <span class="kicker">{copy.sermonKicker}</span>
        <h2>{copy.sermonTitle}</h2>
        <p>{copy.series}</p>
        <a class="btn btn--ghost" href={routes.teaching[lang]}>{copy.sermons}</a>
      </div>
    </div>
  </section>

  <section class="panels">
    <div class="panel panel--orange">
      <span class="giant-bg" aria-hidden="true">{copy.bapGiant}</span>
      <div class="panel-photo"><img src="/img/bautismo-nino-sm.webp" alt={copy.bapAlt} loading="lazy" width="900" height="600" /></div>
      <h2>{copy.bapTitle}</h2>
      <p>{copy.bapText}</p>
      <a class="btn" href={routes.baptism[lang]}>{copy.bapBtn}</a>
    </div>
    <div class="panel panel--cream">
      <h2>{copy.houseTitle}</h2>
      <div class="panel-photo"><img src="/img/iglesia-en-casa-sm.webp" alt={copy.houseAlt} loading="lazy" width="900" height="1195" /></div>
      <p>{copy.houseText}</p>
      <a class="btn btn--ghost" href={links.joinHouseChurch}>{copy.houseBtn}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap row">
      <div>
        <h2>{copy.ctaTitle}</h2>
        <p class="lead">{copy.ctaText}</p>
      </div>
      <a class="btn btn--orange" href={links.stayConnected}>{copy.ctaBtn}</a>
    </div>
  </section>
</Base>

<style>
  .home-hero > img { object-position: 72% 28%; }
  @media (max-width: 760px) { .home-hero > img { object-position: 60% 20%; } }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 2rem; margin: 0; }
  .facts dt { font-family: var(--display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.85rem; color: var(--orange); padding-top: 0.2rem; }
  .facts dd { margin: 0; }
  .stone { color: var(--stone); }
  .poster { overflow: hidden; }
  .video { border-radius: 0; }
  .sunday-band { background: var(--charcoal); color: var(--cream); padding-block: clamp(2rem, 4vw, 2.75rem); }
  .sb { display: grid; gap: 1.25rem 3rem; align-items: center; }
  @media (min-width: 900px) { .sb { grid-template-columns: auto 1fr auto; } }
  .sb-time { display: flex; align-items: baseline; gap: 0.9rem; font-family: var(--display); font-weight: 900; text-transform: uppercase; line-height: 0.85; }
  .sb-day { font-size: clamp(2.2rem, 1.5rem + 2.6vw, 3.6rem); color: var(--cream); }
  .sb-hour { font-size: clamp(3.4rem, 2.2rem + 4.6vw, 6.2rem); color: var(--orange); }
  .sb-place { display: grid; gap: 0.2rem; font-size: var(--step-1); line-height: 1.3; }
  .sb-place strong { font-weight: 600; color: var(--white); }
  .sb-place span { color: rgba(250,246,240,0.82); }
  .sb-place em { font-family: var(--scripture); color: var(--stone); font-size: var(--step-0); }
  .sb-btns { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 760px) { .sb-btns .btn--orange { display: none; } }
  .btn--light-ghost { background: transparent; border-color: var(--cream); color: var(--cream); }
  .btn--light-ghost:hover { background: var(--cream); color: var(--charcoal); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem 3rem; }
  .row h2 { max-width: 22ch; }
</style>
