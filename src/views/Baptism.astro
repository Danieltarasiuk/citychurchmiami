---
// Bautismo. Contenido tomado de la Guía de Bautismo (clase pre-bautismal).
// Cuando haya fecha y formulario propio, actualiza nextDate y signup.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { links, routes, type Lang } from '../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;

const signup = links.stayConnected; // TODO: formulario propio de bautismo
const nextDate: Record<Lang, string> = { es: 'Próxima fecha por anunciar', en: 'Next date coming soon' };

const copy = {
  es: {
    title: 'Bautismo',
    description: 'El bautismo es tu declaración pública de que perteneces a Jesús. Conoce qué es, quién puede bautizarse y cómo prepararte en CityChurch Miami.',
    kicker: 'Bautismo',
    h1: 'Sepultado con Cristo. Resucitado a una vida nueva.',
    lead: 'El bautismo es tu declaración pública de que perteneces a Jesús. Si ya confiaste en Él, te queremos acompañar en este paso.',
    heroAlt: 'Una mujer sonríe al salir del agua en su bautismo, junto a dos pastores',
    cta: 'Quiero bautizarme',
    guide: 'Descarga la guía',
    guideFile: '/guias/CityChurch-Guia-de-Bautismo.pdf',
    whatKicker: '¿Qué es el bautismo?',
    whatTitle: 'Lo de adentro, contado afuera.',
    what: [
      'Al entrar en el agua, representas que fuiste sepultado con Cristo; al salir, que resucitaste con Él a una vida nueva. Es la expresión externa de una realidad interna, y un acto de obediencia al mandato de Jesús.',
      'Piensa en un anillo de bodas. El anillo no te hace casado, pero le dice al mundo que lo estás. El bautismo no te salva, pero le dice al mundo que has sido salvado.',
    ],
    verse: '«Por tanto, hemos sido sepultados con Él por medio del bautismo para muerte, a fin de que como Cristo resucitó de entre los muertos por la gloria del Padre, así también nosotros andemos en novedad de vida.»',
    ref: 'Romanos 6:4 (NBLA)',
    isTitle: 'Lo que el bautismo es',
    is: ['Un acto de obediencia a Jesús', 'Una confesión pública de tu fe', 'Una imagen de tu unión con Cristo en Su muerte y resurrección', 'Una celebración junto a tu familia de la iglesia'],
    notTitle: 'Lo que no es',
    not: ['No es lo que te salva. Somos salvos por gracia por medio de la fe (Efesios 2:8–9).', 'No es un ritual que funciona por sí solo. Sin fe, es solo mojarse.', 'No es una garantía de que nunca más vas a luchar.', 'No es algo que se repite cada vez que vuelves a comprometerte con Dios.'],
    babyKicker: 'Una pregunta común',
    babyTitle: '¿Y si me bautizaron de bebé?',
    baby: 'A muchos de nosotros nos bautizaron de bebés, y honramos la intención de nuestras familias: querían que estuviéramos cerca de Dios. Pero en el Nuevo Testamento, el bautismo siempre sigue a la fe personal. Un bebé todavía no puede arrepentirse ni creer. Si te bautizaron antes de confiar personalmente en Jesús, te invitamos a bautizarte ahora como tu propia respuesta a Él. No es rechazar a tu familia. Es tu propio sí a Jesús.',
    whoTitle: '¿Quién puede bautizarse?',
    who: 'Cualquier persona que se haya arrepentido de su pecado y haya confiado personalmente en Jesús como Salvador y Señor (Hechos 2:38). Con los niños, conversamos con cada familia para asegurarnos de que el niño entiende y de que la decisión es verdaderamente suya.',
    whenTitle: '¿Cuándo?',
    when: 'Pronto. En el libro de Hechos, las personas se bautizaban poco después de creer. Si ya confiaste en Jesús, no hay razón para esperar años. Y si te frena el miedo o sientes que no estás listo: el bautismo no es un diploma para los maduros, es la línea de salida para los perdonados.',
    stepsKicker: 'Cómo funciona',
    stepsTitle: 'Tres pasos sencillos.',
    steps: [
      { t: 'Una clase', d: 'Una clase bilingüe de 90 minutos donde vemos qué significa el bautismo. Te llevas una guía para leer en casa.' },
      { t: 'Una conversación', d: 'Te sientas con un pastor de 20 a 30 minutos para escuchar tu historia con Jesús y preparar tu testimonio. No es un examen.' },
      { t: 'Un domingo', d: 'Te bautizas durante la reunión del domingo para que toda la iglesia celebre contigo, por inmersión, en el nombre del Padre, del Hijo y del Espíritu Santo.' },
    ],
    stripAlt: ['Una familia celebra el bautismo de su hijo', 'Una niña se prepara para su bautismo con sus padres', 'Una mujer comparte antes de su bautismo', 'Un joven sale del agua en su bautismo'],
    dayKicker: 'El día del bautismo',
    dayTitle: 'Lo que necesitas saber.',
    day: [
      'Llega 20 a 30 minutos antes para recibir las instrucciones.',
      'Te damos la camiseta de Bautismo. Usa short o pantalón oscuro que se pueda mojar.',
      'Trae una toalla, sandalias y un cambio de ropa.',
      'Invita a tu familia y amigos. ¡Es un día para celebrar!',
    ],
    testimonyTitle: 'Tu testimonio',
    testimony: 'Antes de entrar al agua vas a compartir 1 o 2 minutos. Te ayudamos a prepararlo con tres preguntas:',
    questions: ['¿Cómo era mi vida antes de Jesús?', '¿Cómo llegué a confiar en Él?', '¿Qué ha estado haciendo en mí desde entonces?'],
    ctaTitle: '¿Listo para dar el paso?',
    ctaText: 'Déjanos tus datos y te contactamos para la próxima clase de bautismo.',
    notReady: '¿Todavía tienes preguntas sobre Jesús?',
    notReadyLink: 'Empieza aquí',
  },
  en: {
    title: 'Baptism',
    description: 'Baptism is your public declaration that you belong to Jesus. Learn what it is, who can be baptized, and how to prepare at CityChurch Miami.',
    kicker: 'Baptism',
    h1: 'Buried with Christ. Raised to new life.',
    lead: 'Baptism is your public declaration that you belong to Jesus. If you have trusted Him, we want to walk with you in this step.',
    heroAlt: 'A woman smiles as she comes up from the water at her baptism, with two pastors',
    cta: 'I want to be baptized',
    guide: 'Download the guide',
    guideFile: '/guias/CityChurch-Baptism-Guide.pdf',
    whatKicker: 'What is baptism?',
    whatTitle: 'What happened inside, told outside.',
    what: [
      'Going under the water pictures being buried with Christ; coming up pictures rising with Him to a new life. It is an outward expression of an inward reality, and an act of obedience to Jesus’ command.',
      'Think of a wedding ring. The ring doesn’t make you married, but it tells the world you are. Baptism doesn’t save you, but it tells the world you’ve been saved.',
    ],
    verse: '“We were buried therefore with him by baptism into death, in order that, just as Christ was raised from the dead by the glory of the Father, we too might walk in newness of life.”',
    ref: 'Romans 6:4 (ESV)',
    isTitle: 'What baptism is',
    is: ['An act of obedience to Jesus', 'A public confession of your faith', 'A picture of your union with Christ in His death and resurrection', 'A celebration with your church family'],
    notTitle: 'What it isn’t',
    not: ['Not what saves you. We are saved by grace through faith (Ephesians 2:8–9).', 'Not a ritual that works on its own. Without faith, it’s just getting wet.', 'Not a guarantee you’ll never struggle again.', 'Not something to repeat every time you recommit to God.'],
    babyKicker: 'A common question',
    babyTitle: 'What if I was baptized as a baby?',
    baby: 'Many of us were baptized as infants, and we honor what our families intended: they wanted us close to God. But baptism in the New Testament always follows personal faith. A baby cannot yet repent and believe. If you were baptized before you personally trusted in Jesus, we invite you to be baptized now as your own response to Him. It isn’t a rejection of your family. It’s your own yes to Jesus.',
    whoTitle: 'Who can be baptized?',
    who: 'Anyone who has repented of sin and personally trusted in Jesus as Savior and Lord (Acts 2:38). For children, we talk with each family to make sure the child understands and the decision is truly theirs.',
    whenTitle: 'When?',
    when: 'Soon. In the book of Acts, people were baptized shortly after believing. If you have trusted Jesus, there’s no reason to wait years. And if fear or "I’m not ready" is holding you back: baptism is not a diploma for the mature, it’s a starting line for the forgiven.',
    stepsKicker: 'How it works',
    stepsTitle: 'Three simple steps.',
    steps: [
      { t: 'A class', d: 'One 90-minute bilingual class on what baptism means. You take home a guide to read.' },
      { t: 'A conversation', d: 'Sit down with a pastor for 20 to 30 minutes to share your story with Jesus and prepare your testimony. It’s not an exam.' },
      { t: 'A Sunday', d: 'You’re baptized during the Sunday gathering so the whole church celebrates with you, by immersion, in the name of the Father, the Son, and the Holy Spirit.' },
    ],
    stripAlt: ['A family celebrates their son’s baptism', 'A girl gets ready for her baptism with her parents', 'A woman shares before her baptism', 'A young man comes up from the water at his baptism'],
    dayKicker: 'Baptism day',
    dayTitle: 'What to know.',
    day: [
      'Arrive 20 to 30 minutes early for instructions.',
      'We give you the Bautismo shirt. Wear dark shorts or pants you don’t mind getting wet.',
      'Bring a towel, sandals, and a change of clothes.',
      'Invite your family and friends. It’s a day to celebrate!',
    ],
    testimonyTitle: 'Your testimony',
    testimony: 'Before going into the water you’ll share for 1 to 2 minutes. We’ll help you prepare it with three questions:',
    questions: ['What was my life like before Jesus?', 'How did I come to trust in Him?', 'What has He been doing in me since?'],
    ctaTitle: 'Ready to take the step?',
    ctaText: 'Leave us your info and we’ll reach out about the next baptism class.',
    notReady: 'Still have questions about Jesus?',
    notReadyLink: 'Start here',
  },
}[lang];
const strip = ['bautismo-familia', 'bautismo-nina', 'bautismo-mujer', 'bautismo-joven'];
---
<Base lang={lang} page="baptism" title={copy.title} description={copy.description} image="/img/bautismo-alegria.webp">
  <PageHero kicker={copy.kicker} title={copy.h1} lead={copy.lead} image="/img/bautismo-alegria" position="70% 28%" alt={copy.heroAlt}>
    <div class="btn-row">
      <a class="btn btn--orange" href={signup}>{copy.cta}</a>
      <a class="btn btn--ghost" href={copy.guideFile} download>{copy.guide}</a>
    </div>
  </PageHero>

  <section class="section poster-sec">
    <div class="wrap split split--wide-left">
      <div>
        <p class="giant" aria-hidden="true">{copy.kicker}</p>
        <span class="kicker">{copy.whatKicker}</span>
        <h2>{copy.whatTitle}</h2>
        {copy.what.map((p) => <p>{p}</p>)}
      </div>
      <blockquote class="scripture">{copy.verse}<cite>{copy.ref}</cite></blockquote>
    </div>
  </section>

  <section class="panels">
    <div class="panel panel--cream">
      <h2>{copy.isTitle}</h2>
      <ul class="list yes">{copy.is.map((i) => <li>{i}</li>)}</ul>
    </div>
    <div class="panel panel--dark">
      <h2>{copy.notTitle}</h2>
      <ul class="list no">{copy.not.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <section class="section section--teal">
    <div class="wrap narrow">
      <span class="kicker">{copy.babyKicker}</span>
      <h2>{copy.babyTitle}</h2>
      <p class="lead">{copy.baby}</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap grid-2">
      <div><h3>{copy.whoTitle}</h3><p>{copy.who}</p></div>
      <div><h3>{copy.whenTitle}</h3><p>{copy.when}</p></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{copy.stepsKicker}</span>
        <h2>{copy.stepsTitle}</h2>
      </div>
      <div class="grid-3">
        {copy.steps.map((s, i) => (
          <article class="card"><span class="num">0{i + 1}</span><h3>{s.t}</h3><p class="muted">{s.d}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="strip" aria-label={lang === 'es' ? 'Fotos de bautismos' : 'Baptism photos'}>
    {strip.map((img, i) => (
      <div class="strip-photo"><img src={`/img/${img}-sm.webp`} alt={copy.stripAlt[i]} loading="lazy" width="900" height="600" /></div>
    ))}
  </section>

  <section class="section section--white">
    <div class="wrap split">
      <div>
        <span class="kicker">{copy.dayKicker}</span>
        <h2>{copy.dayTitle}</h2>
        <ul class="list yes">{copy.day.map((d) => <li>{d}</li>)}</ul>
      </div>
      <div class="card testimony">
        <h3>{copy.testimonyTitle}</h3>
        <p class="muted">{copy.testimony}</p>
        <ol>{copy.questions.map((q) => <li>{q}</li>)}</ol>
      </div>
    </div>
  </section>

  <section class="section section--orange">
    <div class="wrap cta">
      <div>
        <span class="date">{nextDate[lang]}</span>
        <h2>{copy.ctaTitle}</h2>
        <p class="lead">{copy.ctaText}</p>
        <p class="small">{copy.notReady} <a href={routes.jesus[lang]}>{copy.notReadyLink}</a></p>
      </div>
      <div class="btn-col">
        <a class="btn" href={signup}>{copy.cta}</a>
        <a class="btn btn--ghost" href={copy.guideFile} download>{copy.guide}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .poster-sec { overflow: hidden; }
  .poster-sec .giant { font-size: clamp(4rem, 1.5rem + 11vw, 11rem); margin-bottom: 0.3em; }
  .poster-sec .scripture { align-self: end; }
  .list { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.9rem; max-width: 46ch; }
  .list li { position: relative; padding-left: 2rem; }
  .list li::before { position: absolute; left: 0; top: 0; font-family: var(--display); font-weight: 900; font-size: 1.2rem; line-height: 1.4; }
  .yes li::before { content: '✓'; color: var(--orange-ink); }
  .panel--dark .list li::before, .no li::before { content: '✕'; color: var(--orange); }
  .narrow { max-width: 820px; }
  .grid-2 h3 { margin-bottom: 0.5em; }
  .strip { display: grid; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 860px) { .strip { grid-template-columns: repeat(4, 1fr); } }
  .strip-photo { aspect-ratio: 4 / 3; overflow: hidden; }
  .strip-photo img { width: 100%; height: 100%; object-fit: cover; }
  .testimony ol { margin: 1rem 0 0; padding-left: 1.3rem; display: grid; gap: 0.6rem; font-family: var(--scripture); font-style: italic; font-size: var(--step-1); }
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .date { display: inline-block; font-family: var(--display); font-weight: 900; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--step-1); border: 2px solid var(--charcoal); border-radius: 999px; padding: 0.3em 0.9em; margin-bottom: 1.25rem; }
  .small { margin-top: 1rem; }
  .small a { font-weight: 600; }
  .btn-col { display: flex; flex-direction: column; gap: 0.75rem; }
</style>
