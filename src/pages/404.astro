---
import Base from '../layouts/Base.astro';
---
<Base lang="es" page="home" title="Página no encontrada" description="Esta página no existe.">
  <section class="section">
    <div class="wrap">
      <span class="kicker">404</span>
      <h1>Esta página no existe.</h1>
      <p class="lead">Puede que el enlace haya cambiado con el nuevo sitio. / This page doesn't exist. The link may have changed with our new site.</p>
      <div class="btn-row">
        <a class="btn btn--orange" href="/">Ir al inicio</a>
        <a class="btn btn--ghost" href="/en/">Go home (English)</a>
      </div>
    </div>
  </section>
</Base>
