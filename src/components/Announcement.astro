---
// Barra de anuncio arriba del menú: reunión en inglés.
// Se puede cerrar (se recuerda en ese teléfono). La "próxima reunión" se actualiza sola.
import { englishMeetings, routes, type Lang } from '../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const es = lang === 'es';

const months: Record<string, string> = { December: 'diciembre', January: 'enero', February: 'febrero', March: 'marzo' };
const dates = englishMeetings.dates.map((d) => ({
  iso: d.iso,
  es: `domingo ${d.date.split(' ')[1]} de ${months[d.date.split(' ')[0]] ?? d.date.split(' ')[0]}`,
  en: `Sunday, ${d.short}`,
}));
const today = new Date().toISOString().slice(0, 10);
const next = dates.find((d) => d.iso >= today);
---
<div class="announce" id="announce" lang={lang} data-dates={JSON.stringify(dates)}>
  <a class="announce-link" href={routes.english.en}>
    <span class="announce-main">{es ? '¿Hablas inglés? Estamos empezando una reunión en inglés' : 'An English gathering launches Easter Sunday'}</span>
    <span class="announce-next" data-next-label={es ? 'Próxima reunión:' : 'Next meeting:'}>
      {next ? (es ? `Próxima reunión: ${next.es}` : `Next meeting: ${next.en}`) : (es ? 'Comienza el Domingo de Resurrección' : 'Launching Easter Sunday, March 28')}
    </span>
    <span class="announce-cta">{es ? 'Más información →' : 'Learn more →'}</span>
  </a>
  <button type="button" class="announce-close" aria-label={es ? 'Cerrar anuncio' : 'Close announcement'}>×</button>
</div>

<script>
  const bar = document.getElementById('announce');
  if (bar) {
    // Actualiza la próxima fecha en el navegador (por si el sitio no se ha vuelto a publicar).
    try {
      const dates = JSON.parse(bar.dataset.dates ?? '[]') as { iso: string; es: string; en: string }[];
      const today = new Date().toISOString().slice(0, 10);
      const next = dates.find((d) => d.iso >= today);
      const el = bar.querySelector<HTMLElement>('.announce-next');
      const es = bar.lang === 'es';
      if (el) el.textContent = next ? `${el.dataset.nextLabel} ${es ? next.es : next.en}` : (es ? 'Comienza el Domingo de Resurrección' : 'Launching Easter Sunday, March 28');
    } catch {}
    bar.querySelector('.announce-close')?.addEventListener('click', () => {
      document.documentElement.classList.add('announce-off');
      try { localStorage.setItem('cc-announce', 'english-2027'); } catch {}
    });
  }
</script>

<style>
  .announce { position: relative; background: var(--orange); color: var(--charcoal); }
  :global(.announce-off) .announce { display: none; }
  .announce-link { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.25rem 1rem; padding: 0.6rem 3rem; text-decoration: none; font-size: 0.92rem; line-height: 1.3; text-align: center; }
  .announce-main { font-weight: 600; }
  .announce-next { opacity: 0.85; }
  .announce-cta { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  .announce-close { position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border: 0; background: transparent; font-size: 1.5rem; line-height: 1; cursor: pointer; color: var(--charcoal); }
  @media (max-width: 640px) { .announce-next { display: none; } .announce-link { padding-inline: 1rem 2.75rem; font-size: 0.85rem; } }
</style>
