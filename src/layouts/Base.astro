---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang, RouteKey } from '../data/site';
import { routes } from '../data/site';

interface Props {
  lang: Lang;
  page: RouteKey;
  title: string;
  description: string;
  image?: string;
  bare?: boolean;
}
const { lang, page, title, description, image = '/img/domingo-reunion.webp', bare = false } = Astro.props;
const site = Astro.site!;
const fullTitle = page === 'home' ? title : `${title} | CityChurch Miami`;
const canonical = new URL(routes[page][lang], site).href;
const alt = new URL(routes[page][lang === 'es' ? 'en' : 'es'], site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alt} />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="apple-touch-icon" href="/brand/icon-180.png" />
    <meta name="theme-color" content="#FAF6F0" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CityChurch Miami" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Church',
      name: 'CityChurch Miami',
      url: 'https://citychurch.miami',
      logo: 'https://citychurch.miami/brand/icon-512.png',
      address: { '@type': 'PostalAddress', streetAddress: '10415 NW 52nd St', addressLocality: 'Doral', addressRegion: 'FL', postalCode: '33178', addressCountry: 'US' },
      sameAs: ['https://www.youtube.com/@citychurchmiami', 'https://www.instagram.com/iglesiadelaciudad.miami/', 'https://www.instagram.com/citychurch.miami/', 'https://www.facebook.com/iglesiadelaciudad.miami/'],
    })} />
    <!-- Church Center: abre formularios y donaciones en una ventana sobre el sitio -->
    <script src="https://js.churchcenter.com/modal/v1" defer></script>
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">{lang === 'es' ? 'Ir al contenido' : 'Skip to content'}</a>
    {!bare && <Header lang={lang} page={page} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
  </body>
</html>
